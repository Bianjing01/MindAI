// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://next:020128@localhost:3306/next"
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime    @default(now())
  image     String?
  posts     Post[]
  comments  Comment[]
  testResults TestResult[] // 反向关系字段
  moods     MoodRecord[]
  likes     Like[]
  favorites Favorite[]
}

model Post {
  id         Int       @id @default(autoincrement())
  title      String
  content    String    @db.Text
  category   String
  status     String    @default("")
  authorName String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     Int
  isAnonymous Boolean  @default(false)
  user       User      @relation(fields: [userId], references: [id])
  comments   Comment[]
  viewCount  Int       @default(0)
  likes      Like[]
  favorites  Favorite[]

  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    Int
  userId    Int
  isAnonymous Boolean @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

model TestResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  category  String
  scores    Json
  totalScore Int
  details   String   @db.Text  // 修改为 Text 类型，可以存储更长的文本
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model MoodRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   // YYYY-MM-DD 格式
  mood      String
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
}